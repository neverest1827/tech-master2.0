<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isNew ? 'Создание FAQ' : 'Редактирование FAQ' %> | Админка</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f4f5;
            color: #18181b;
        }
        .layout {
            max-width: 820px;
            margin: 0 auto;
            padding: 32px 16px 48px;
        }
        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }
        h1 { margin: 0; }
        .back {
            color: #dc2626;
            text-decoration: none;
        }
        .back:hover { text-decoration: underline; }
        .notice {
            margin-bottom: 16px;
            padding: 12px 14px;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            background: #f0fdf4;
            color: #166534;
        }
        .card {
            padding: 24px;
            border: 1px solid #e4e4e7;
            border-radius: 8px;
            background: #fff;
        }
        .meta {
            margin: 0 0 20px;
            color: #71717a;
        }
        .field {
            display: grid;
            gap: 8px;
            margin-bottom: 20px;
        }
        fieldset {
            display: grid;
            gap: 14px;
            margin: 0 0 20px;
            padding: 18px;
            border: 1px solid #e4e4e7;
            border-radius: 8px;
        }
        legend {
            padding: 0 6px;
            font-weight: 700;
        }
        .scope-option {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-weight: 400;
            cursor: pointer;
        }
        .scope-option input {
            width: auto;
            margin-top: 2px;
        }
        .scope-option strong {
            display: block;
            margin-bottom: 3px;
        }
        .scope-option span {
            color: #71717a;
            font-size: 13px;
            line-height: 1.4;
        }
        label {
            font-weight: 700;
        }
        input, textarea, select {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #d4d4d8;
            border-radius: 8px;
            background: #fff;
            color: #18181b;
            font: inherit;
        }
        textarea, select {
            min-height: 220px;
            line-height: 1.5;
        }
        textarea { resize: vertical; }
        select {
            min-height: 260px;
            padding: 6px;
        }
        select option {
            padding: 8px 10px;
        }
        select:disabled {
            background: #f4f4f5;
            color: #a1a1aa;
            cursor: not-allowed;
        }
        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #dc2626;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, .12);
        }
        .hint {
            margin: 0;
            color: #71717a;
            font-size: 13px;
            line-height: 1.45;
        }
        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }
        button, .secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 10px 16px;
            border: 1px solid #dc2626;
            border-radius: 8px;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
        }
        button {
            background: #dc2626;
            color: #fff;
        }
        button:hover { background: #b91c1c; }
        .secondary {
            background: #fff;
            color: #dc2626;
        }
        @media (max-width: 600px) {
            .top {
                align-items: flex-start;
                flex-direction: column;
            }
            .card { padding: 18px; }
            .actions > * { width: 100%; }
        }
    </style>
</head>
<body>
<div class="layout">
    <div class="top">
        <h1><%= isNew ? 'Создание FAQ' : 'Редактирование FAQ' %></h1>
        <a class="back" href="/admin/faqs">К списку FAQ</a>
    </div>

    <% if (saved) { %>
        <div class="notice">Изменения сохранены.</div>
    <% } %>

    <div class="card">
        <% if (!isNew) { %>
            <p class="meta">ID: <strong><%= faq.id %></strong></p>
        <% } %>

        <form method="post" action="<%= isNew ? '/admin/faqs' : `/admin/faqs/${faq.id}` %>">
            <% const selectedOfferIds = new Set((faq?.offer || []).map((offer) => offer.id)); %>
            <% const isGeneral = selectedOfferIds.size === 0; %>

            <div class="field">
                <label for="question">Вопрос</label>
                <input
                    id="question"
                    name="question"
                    type="text"
                    value="<%= faq?.question || '' %>"
                    maxlength="2000"
                    required
                >
            </div>

            <div class="field">
                <label for="answer">Ответ</label>
                <textarea id="answer" name="answer" required><%= faq?.answer || '' %></textarea>
                <p class="hint">Ответ отображается на сайте как обычный текст. Переносы строк сохраняются в редакторе.</p>
            </div>

            <fieldset>
                <legend>Где показывать FAQ</legend>
                <label class="scope-option">
                    <input type="radio" name="scope" value="general" <%= isGeneral ? 'checked' : '' %>>
                    <span>
                        <strong>Общий вопрос</strong>
                        Показывается в общих FAQ на главной странице и в других общих разделах.
                    </span>
                </label>
                <label class="scope-option">
                    <input type="radio" name="scope" value="offers" <%= !isGeneral ? 'checked' : '' %>>
                    <span>
                        <strong>Для конкретных услуг</strong>
                        Показывается только на выбранных страницах услуг.
                    </span>
                </label>
            </fieldset>

            <div class="field" id="offer-selection">
                <label for="offerIds">Услуги</label>
                <select id="offerIds" name="offerIds" multiple <%= isGeneral ? 'disabled' : '' %>>
                    <% offers.forEach((offer) => { %>
                        <option value="<%= offer.id %>" <%= selectedOfferIds.has(offer.id) ? 'selected' : '' %>>
                            <%= offer.meta?.title || offer.slug %>
                        </option>
                    <% }) %>
                </select>
                <p class="hint">Можно выбрать несколько услуг: Ctrl + клик в Windows или Cmd + клик в macOS.</p>
            </div>

            <div class="actions">
                <button type="submit"><%= isNew ? 'Создать FAQ' : 'Сохранить изменения' %></button>
                <a class="secondary" href="/admin/faqs">Отмена</a>
            </div>
        </form>
    </div>
</div>
<script>
    const scopeInputs = document.querySelectorAll('input[name="scope"]');
    const offerSelect = document.querySelector('#offerIds');

    function updateOfferSelection() {
        const selectedScope = document.querySelector('input[name="scope"]:checked')?.value;
        offerSelect.disabled = selectedScope !== 'offers';
        offerSelect.required = selectedScope === 'offers';
    }

    scopeInputs.forEach((input) => input.addEventListener('change', updateOfferSelection));
    updateOfferSelection();
</script>
</body>
</html>
