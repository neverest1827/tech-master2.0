<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <% if (env === 'dev') { %>
        <!-- В Dev-режиме загружаем Vite напрямую -->
        <script type="module" src="http://localhost:5173/@vite/client"></script>
    <% } else { %>
        <!-- В продакшене загружаем сгенерированные файлы -->
        <link rel="stylesheet" href="/static/assets/<%= `${styleName}.min.css` %>">
    <% } %>
</head>