                                                                                class="dropdown__article-title"
                                                                                title="<%= blog.title %>"
                                                                        >
                                                                            <%= blog.title.length > MAX_TITLE_LENGTH ? blog.title.substring(0, 25).trim() + '…' : blog.title %>
                                                                        </h4>
                                                                    </a>
                                                                </li>
                                                                <li class="dropdown__article-item">
                                                                    <p class="dropdown__article-description">
                                                                        <%= blog.description.length > MAX_DESCRIPTION_LENGTH
                                                                                ? blog.description.substring(0, 100).trim() + '…'
                                                                                : blog.description
                                                                        %>
                                                                    </p>
                                                                </li>
