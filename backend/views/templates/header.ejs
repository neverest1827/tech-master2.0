                                                        <li class="dropdown__blog-item dropdown__article">
                                                            <a class="dropdown__img-link" href="<%= `/blog/${blog.slug}` %>">
                                                                <img
                                                                        class="dropdown__article-img"
                                                                        src="<%= blog.previewImageURL || '/public/img/no-image.jpg' %>"
                                                                        alt="Превью статьи"
                                                                        loading="lazy"
                                                                >
                                                            </a>
