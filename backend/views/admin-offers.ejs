<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админка услуг</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f4f5;
            color: #18181b;
        }
        .layout {
            max-width: 1100px;
            margin: 0 auto;
            padding: 32px 16px 48px;
        }
        h1 {
            margin: 0 0 24px;
        }
        .card {
            background: #fff;
            border: 1px solid #e4e4e7;
            border-radius: 12px;
            overflow: hidden;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid #e4e4e7;
            vertical-align: top;
        }
        th {
            background: #fafafa;
        }
        a {
            color: #dc2626;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .muted {
            color: #71717a;
        }
    </style>
</head>
<body>
<div class="layout">
    <h1>Статьи услуг</h1>
    <div class="card">
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Slug</th>
                <th>Title</th>
                <th>Обновлено</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            <% offers.forEach((offer) => { %>
                <tr>
                    <td><%= offer.id %></td>
                    <td><code><%= offer.slug %></code></td>
                    <td><%= offer.meta?.title || 'Без title' %></td>
                    <td class="muted"><%= offer.updatedAt %></td>
                    <td><a href="/admin/offers/<%= offer.id %>">Открыть</a></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
</div>
</body>
</html>
