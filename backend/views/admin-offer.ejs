<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Редактор услуги</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f4f5;
            color: #18181b;
        }
        .layout {
            display: grid;
            grid-template-columns: minmax(320px, 520px) 1fr;
            min-height: 100vh;
        }
        .panel {
            padding: 24px;
            background: #ffffff;
            border-right: 1px solid #e4e4e7;
        }
        .preview {
            background: #e4e4e7;
        }
        .topline {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }
        .meta {
            margin-bottom: 16px;
            padding: 12px;
            border: 1px solid #e4e4e7;
            border-radius: 12px;
            background: #fafafa;
        }
        .meta p {
            margin: 6px 0;
            word-break: break-word;
        }
        textarea {
            width: 100%;
            min-height: 60vh;
            resize: vertical;
            border: 1px solid #d4d4d8;
            border-radius: 12px;
            padding: 14px;
            font: 14px/1.5 Consolas, monospace;
            box-sizing: border-box;
        }
        .actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }
        button, .link-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: 10px;
            padding: 12px 16px;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }
        button {
            background: #dc2626;
            color: #fff;
        }
        .link-button {
            background: #18181b;
            color: #fff;
        }
        .message {
            margin: 0 0 16px;
            padding: 12px;
            border-radius: 10px;
            background: #dcfce7;
            color: #166534;
        }
        iframe {
            width: 100%;
            height: 100vh;
            border: 0;
            background: #fff;
        }
        code {
            background: #f4f4f5;
            padding: 2px 6px;
            border-radius: 6px;
        }
        @media (max-width: 1100px) {
            .layout {
                grid-template-columns: 1fr;
            }
            .panel {
                border-right: none;
                border-bottom: 1px solid #e4e4e7;
            }
            iframe {
                height: 70vh;
            }
        }
    </style>
</head>
<body>
<div class="layout">
    <div class="panel">
        <div class="topline">
            <h1>Редактор услуги</h1>
            <a class="link-button" href="/admin/offers">К списку</a>
        </div>

        <% if (saved) { %>
            <p class="message">Изменения сохранены.</p>
        <% } %>

        <div class="meta">
            <p><strong>ID:</strong> <%= offer.id %></p>
            <p><strong>Slug:</strong> <code><%= offer.slug %></code></p>
            <p><strong>Title:</strong> <%= offer.meta?.title || 'Без title' %></p>
        </div>

        <form method="post" action="/admin/offers/<%= offer.id %>">
            <label for="content"><strong>HTML статьи</strong></label>
            <textarea id="content" name="content"><%- offer.content %></textarea>
            <div class="actions">
                <button type="submit">Сохранить</button>
                <a class="link-button" href="/admin/offers/<%= offer.id %>/preview" target="_blank">Открыть preview</a>
            </div>
        </form>
    </div>
    <div class="preview">
        <iframe src="/admin/offers/<%= offer.id %>/preview" title="Предпросмотр статьи"></iframe>
    </div>
</div>
</body>
</html>
