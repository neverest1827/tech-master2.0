<!DOCTYPE html>
<html lang="ru">
<%- include('templates/head'); -%>
<body>
<%- include('templates/header'); -%>
<main>
    <div class="article-page">
        <% if (typeof previewImageURL !== 'undefined' && previewImageURL) {
            const cover = `<figure class="article__cover"><img class="article__cover-img" src="${previewImageURL}" alt=""></figure>`;
        %>
            <%- content.replace('</header>', `</header>${cover}`) %>
        <% } else { %>
            <%- content %>
        <% } %>
    </div>
    <%- include('templates/faq'); -%>
    <%- include('templates/modal'); -%>
</main>
<%- include('templates/footer'); -%>
<% if (env === 'dev') { %>
    <script type="module" src="http://localhost:5173/src/<%= `${scriptName}.ts` %>"></script>
<% } else { %>
    <script type="module" src="/public/assets/<%= `${scriptName}.js` %>"></script>
<% } %>
</body>
</html>
