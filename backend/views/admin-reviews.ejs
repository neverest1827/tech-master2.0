<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админка отзывов</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f4f5;
            color: #18181b;
        }
        .layout {
            max-width: 1180px;
            margin: 0 auto;
            padding: 32px 16px 48px;
        }
        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }
        h1 {
            margin: 0;
        }
        .nav {
            display: flex;
            gap: 12px;
        }
        .card {
            background: #fff;
            border: 1px solid #e4e4e7;
            border-radius: 12px;
            overflow: hidden;
        }
        .notice {
            margin-bottom: 16px;
            padding: 12px 14px;
            border: 1px solid #bbf7d0;
            border-radius: 10px;
            background: #f0fdf4;
            color: #166534;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid #e4e4e7;
            vertical-align: top;
        }
        th {
            background: #fafafa;
        }
        tr:last-child td {
            border-bottom: none;
        }
        a {
            color: #dc2626;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .muted {
            color: #71717a;
            font-size: 13px;
        }
        .text {
            max-width: 420px;
            white-space: pre-wrap;
        }
        .text-form {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-width: 420px;
        }
        textarea {
            width: 100%;
            min-height: 110px;
            box-sizing: border-box;
            padding: 10px;
            border: 1px solid #d4d4d8;
            border-radius: 8px;
            resize: vertical;
            font: inherit;
            line-height: 1.45;
        }
        textarea:focus {
            outline: none;
            border-color: #dc2626;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, .12);
        }
        .badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }
        .badge--approved {
            background: #dcfce7;
            color: #166534;
        }
        .badge--pending {
            background: #fee2e2;
            color: #991b1b;
        }
        .actions {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        button {
            border: 1px solid #dc2626;
            border-radius: 8px;
            padding: 8px 12px;
            background: #dc2626;
            color: #fff;
            cursor: pointer;
            font-weight: 700;
        }
        button.secondary {
            background: #fff;
            color: #dc2626;
        }
        button.small {
            align-self: flex-start;
            padding: 7px 10px;
            font-size: 13px;
        }
        button:hover {
            opacity: .88;
        }
    </style>
</head>
<body>
<div class="layout">
    <div class="top">
        <h1>Отзывы</h1>
        <div class="nav">
            <a href="/admin/offers">Услуги</a>
            <a href="/admin/reviews">Отзывы</a>
        </div>
    </div>

    <% if (saved) { %>
        <div class="notice">Статус отзыва обновлён.</div>
    <% } %>

    <div class="card">
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Автор</th>
                <th>Оценка</th>
                <th>Текст</th>
                <th>Дата</th>
                <th>Статус</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            <% if (!reviews.length) { %>
                <tr>
                    <td colspan="7" class="muted">Отзывов пока нет.</td>
                </tr>
            <% } %>
            <% reviews.forEach((review) => { %>
                <% const isApproved = review.isApproved; %>
                <tr>
                    <td><%= review.id %></td>
                    <td><%= review.name %></td>
                    <td><%= review.stars %>/5</td>
                    <td class="text">
                        <form class="text-form" method="post" action="/admin/reviews/<%= review.id %>/text">
                            <textarea name="text" required><%= review.text %></textarea>
                            <button class="small secondary" type="submit">Сохранить текст</button>
                        </form>
                    </td>
                    <td class="muted"><%= review.createdAt.toLocaleString('ru-RU') %></td>
                    <td>
                        <% if (isApproved) { %>
                            <span class="badge badge--approved">Одобрен</span>
                        <% } else { %>
                            <span class="badge badge--pending">На проверке</span>
                        <% } %>
                    </td>
                    <td>
                        <div class="actions">
                            <% if (isApproved) { %>
                                <form method="post" action="/admin/reviews/<%= review.id %>/unapprove">
                                    <button class="secondary" type="submit">Снять</button>
                                </form>
                            <% } else { %>
                                <form method="post" action="/admin/reviews/<%= review.id %>/approve">
                                    <button type="submit">Одобрить</button>
                                </form>
                            <% } %>
                        </div>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
</div>
</body>
</html>
