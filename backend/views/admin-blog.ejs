<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Блог | Админка</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Arial, sans-serif; background: #f4f4f5; color: #18181b; }
        .layout { max-width: 1120px; margin: 0 auto; padding: 32px 16px 48px; }
        .top { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }
        h1 { margin: 0; }
        .nav { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
        a { color: #dc2626; text-decoration: none; }
        a:hover { text-decoration: underline; }
        .button { display: inline-flex; align-items: center; min-height: 40px; padding: 9px 14px; border-radius: 8px; background: #dc2626; color: #fff; font-weight: 700; }
        .button:hover { background: #b91c1c; text-decoration: none; }
        .notice { margin-bottom: 16px; padding: 12px 14px; border: 1px solid #bbf7d0; border-radius: 8px; background: #f0fdf4; color: #166534; }
        .card { overflow: hidden; border: 1px solid #e4e4e7; border-radius: 8px; background: #fff; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 14px 16px; border-bottom: 1px solid #e4e4e7; text-align: left; vertical-align: top; }
        th { background: #fafafa; }
        tr:last-child td { border-bottom: none; }
        .title { max-width: 360px; font-weight: 700; }
        .slug { max-width: 300px; word-break: break-word; }
        .muted { color: #71717a; font-size: 13px; }
        @media (max-width: 760px) {
            .top { align-items: flex-start; flex-direction: column; }
            .card { overflow-x: auto; }
            table { min-width: 760px; }
        }
    </style>
</head>
<body>
<div class="layout">
    <div class="top">
        <h1>Статьи блога</h1>
        <div class="nav">
            <a href="/admin">Админка</a>
            <a href="/admin/offers">Услуги</a>
            <a href="/admin/faqs">FAQ</a>
            <a class="button" href="/admin/blog/new">Создать статью</a>
        </div>
    </div>

    <% if (created) { %>
        <div class="notice">Статья создана.</div>
    <% } %>

    <div class="card">
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Заголовок</th>
                <th>Slug</th>
                <th>Обновлено</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            <% if (!posts.length) { %>
                <tr><td colspan="5" class="muted">Статей пока нет.</td></tr>
            <% } %>
            <% posts.forEach((post) => { %>
                <tr>
                    <td><%= post.id %></td>
                    <td class="title"><%= post.meta?.title || 'Без заголовка' %></td>
                    <td class="slug"><code><%= post.slug %></code></td>
                    <td class="muted"><%= post.updatedAt.toLocaleString('ru-RU') %></td>
                    <td><a href="/admin/blog/<%= post.id %>">Редактировать</a></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
</div>
</body>
</html>
